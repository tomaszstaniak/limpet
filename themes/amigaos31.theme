ansi3=#6b4a00
ansi4=#1a2f80
ansi5=#6e1a6e
ansi6=#0a5a5e
ansi7=#ffffff
ansi8=#3a3a3a
ansi9=#c00000
ansi10=#007000
ansi11=#fff08a
ansi12=#0033cc
ansi13=#a000a0
ansi14=#007a80
ansi15=#ffffff
