RAM:x/term --command RAM:x/does-not-exist
SetEnv XTERM_DIAG_EXIT_STAGE 4
RAM:x/termdiag --command RAM:x/m-exit
Delete >NIL: RAM:pty-diag.txt QUIET
Avail FLUSH >RESULTS:mem3-<tag>-00-start.txt
Avail FLUSH >RESULTS:mem3-<tag>-01-idle.txt
RAM:x/leakctl
RAM:x/leakctl
RAM:x/leakctl
RAM:x/leakctl
RAM:x/leakctl
