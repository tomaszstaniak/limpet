/* Limpet's experimental XTERM: console (doc/xterm-console.md).
 * Install-XTERM assigns LimpetXT: to the Limpet drawer and mounts this
 * until the next reboot; nothing is written to DEVS:, S: or ENVARC:.
 * Every Open of XTERM:... starts its own window, as CON: does. */
XTERM:
    Handler = LimpetXT:xterm-handler
    StackSize = 65536
    Priority = 5
    GlobVec = -1
#
