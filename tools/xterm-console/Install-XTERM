.key DRAWER/A
.bra {
.ket }
; Mounts Limpet's experimental XTERM: console until the next reboot.
; Writes nothing to S:, DEVS: or ENVARC:, and CON: stays as it is.
;   Execute Install-XTERM SYS:Utilities/Limpet
If NOT EXISTS "{DRAWER}/xterm-handler"
  Echo "Install-XTERM: {DRAWER} has no xterm-handler"
  Quit 20
EndIf
If NOT EXISTS "{DRAWER}/aros-xterm-worker"
  Echo "Install-XTERM: {DRAWER} has no aros-xterm-worker"
  Quit 20
EndIf
Assign >NIL: XTERM: EXISTS
If NOT WARN
  Echo "Install-XTERM: XTERM: is already mounted"
  Quit 5
EndIf
Assign LimpetXT: "{DRAWER}"
Mount XTERM: FROM LimpetXT:XTERM.mountlist
If WARN
  Assign LimpetXT: REMOVE
  Echo "Install-XTERM: Mount failed"
  Quit 20
EndIf
Echo "XTERM: is mounted until the next reboot. Try: NewShell WINDOW XTERM:"
